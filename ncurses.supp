# Valgrind suppressions for known libncursesw / libtinfo internal allocations.
# These are in the library, not in our code.

{
   ncurses_newterm_reachable
   Memcheck:Leak
   match-leak-kinds: reachable,possible
   ...
   obj:*/libncursesw*
}
{
   ncurses_newterm_definitely
   Memcheck:Leak
   match-leak-kinds: definite,indirect
   ...
   obj:*/libncursesw*
}
{
   ncurses_tinfo_reachable
   Memcheck:Leak
   match-leak-kinds: reachable,possible
   ...
   obj:*/libtinfo*
}
{
   ncurses_tinfo_definitely
   Memcheck:Leak
   match-leak-kinds: definite,indirect
   ...
   obj:*/libtinfo*
}
